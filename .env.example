# Application
APP_ENV=development
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=focusmood
POSTGRES_USER=focusmood
POSTGRES_PASSWORD=replace-with-local-password

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

# Gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=10
GEMINI_MAX_REQUESTS_PER_DAY=20

# Email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-email-user
MAIL_PASSWORD=replace-with-email-password
MAIL_FROM=no-reply@focusmood.local

# Security and web access
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Mobile development
MOBILE_API_BASE_URL=http://10.0.2.2:8080/api/v1

# Logging
LOG_LEVEL=INFO